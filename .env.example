# ============================================================
# MoeCard 环境变量
#
# 用法：cp .env.example .env  然后按下面的说明填写
#
# ⚠️  .env 已被 .gitignore 忽略。绝对不要把真实的密钥提交到 Git。
# ============================================================

# ---------- 应用 ----------

# production | development
# 生产环境务必设为 production：会关闭 Gin 调试输出，
# 并强制校验 JWT_SECRET 强度与 BASE_URL 是否配置。
APP_ENV=production

APP_HOST=0.0.0.0
APP_PORT=8080

# 应用密钥（预留给对称加密使用）
# 生成：openssl rand -hex 32
APP_KEY=

# 管理员 JWT 签名密钥。**生产环境必须 >= 32 位**，
# 否则任何人都能伪造管理员 token 直接进后台。
# 生成：openssl rand -hex 32
JWT_SECRET=

# 管理员登录有效期
JWT_EXPIRE=12h

# 数据静态加密主密钥。配置后，卡密内容与两步验证密钥都会加密后再落库。
#
# 为什么建议开启：数据库文件一旦泄露（备份丢失、服务器被入侵、云盘误共享），
# 明文卡密可以被直接拿去使用 —— 等同于现金被搬走。
#
# ⚠ 这个密钥必须与数据库分开保管，且**丢失后已加密的卡密永久无法恢复**。
#   已经跑了一段时间才配置的话，执行一次即可加密历史数据：
#     MoeCard-migrate -encrypt-codes
#
# 生成：openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# ---------- 外部访问地址（重要）----------

# 后端的公网地址。支付平台的**异步回调**会打到这里，
# 填错或填成 127.0.0.1 会导致收不到支付通知 → 用户付了钱但订单不发货。
# 例：https://shop.example.com
BASE_URL=https://shop.example.com

# 前端地址。用于生成支付完成后的跳转地址与邮件里的订单链接。
# 前后端一体部署时与 BASE_URL 相同。
FRONTEND_URL=https://shop.example.com

# 是否信任反向代理传来的客户端 IP 请求头。
# 只有在 Nginx / Cloudflare / EdgeOne / ESA 等可信代理后面才设为 true，
# 否则攻击者可以伪造 IP 绕过限流。
#
# 打开后按这个顺序找客户端 IP，命中第一个就停：
#   后台配的自定义头（商城设置 → 安全 → 客户端 IP 识别）
#   → CF-Connecting-IP / EO-Connecting-IP / EO-Client-IP
#   → Ali-Real-Client-IP / Ali-CDN-Real-IP / True-Client-IP
#   → X-Real-IP → X-Forwarded-For
TRUST_PROXY=false

# ---------- 数据库 ----------

# sqlite | mysql
# 默认 SQLite，零依赖，适合单机部署。
# 需要多实例部署时改用 MySQL（SQLite 不支持多进程写）。
DB_DRIVER=sqlite

# SQLite 数据文件路径。相对路径按程序的工作目录算。
#
# 这里刻意用相对路径：直接跑二进制时，数据会落在安装目录下的 data/，
# 备份、迁移、自更新都在同一处。写成 /app/... 那种容器内的绝对路径，
# 二进制部署会在文件系统根目录凭空造出一个 /app/ —— 备份备不到，
# systemd 沙箱（ReadWritePaths）也会直接把它挡住导致起不来。
# Docker 不受影响：镜像和 compose 里各自设了自己的绝对路径。
SQLITE_PATH=data/moecard.db

# MySQL 配置（DB_DRIVER=mysql 时生效）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USERNAME=moecard
MYSQL_PASSWORD=
MYSQL_DATABASE=moecard
MYSQL_CHARSET=utf8mb4

# docker compose --profile mysql 启动内置 MySQL 时需要
MYSQL_ROOT_PASSWORD=

DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# ---------- 日志 ----------

# debug | info | warn | error
LOG_LEVEL=info

# text | json（生产环境建议 json，便于日志采集）
LOG_FORMAT=json

# 留空表示只输出到 stdout（容器部署推荐留空，由 docker logs 收集）
LOG_FILE=

# ---------- 存储 ----------

STORAGE_DRIVER=local
# 同上，相对于工作目录。Docker 里由镜像自己的环境变量覆盖。
STORAGE_LOCAL_PATH=storage/uploads
STORAGE_URL_PREFIX=/uploads

# 单个上传文件大小上限（字节）。默认 5MB。
STORAGE_MAX_SIZE=5242880

# ============================================================
# 以下配置**不在这里填**，请在后台管理界面配置：
#
#   商城名称 / Logo / 公告 / 联系方式 / ICP      → 后台 → 商城设置
#   订单超时时间 / 时区 / 货币                   → 后台 → 商城设置
#   SMTP 邮件服务器                              → 后台 → 邮件配置
#   支付渠道（易支付 / 支付宝 / 微信 / Stripe /
#            HashPay）的商户号与密钥              → 后台 → 支付方式
#
# 为什么放数据库而不是环境变量：
#   1. 支付渠道支持同一类型建多个（主线/备线），环境变量表达不了
#   2. 改配置不需要重启服务
#   3. 后台可以对密钥做脱敏展示与「未修改则保留旧值」的处理
# ============================================================
